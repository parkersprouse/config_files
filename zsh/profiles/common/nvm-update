ensure_exists nvm

local nvm_version
nvm_version="$(curl -sIXHEAD "https://github.com/nvm-sh/nvm/releases/latest" | grep -i '^location:' | tr -d '[:space:]')"
nvm_version="${nvm_version##*/}"
if [[ -z $nvm_version ]]; then return $(return_error "failed to retrieve latest nvm version"); fi

echo "Updating nvm to version $nvm_version"
echo "------------------------------------"

# The 'PROFILE=/dev/null' prefix, used with this specific eval format, prevents the script from auto-updating any of
# the shell profile configs
eval "PROFILE=/dev/null zsh -c 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/$nvm_version/install.sh | bash'"

